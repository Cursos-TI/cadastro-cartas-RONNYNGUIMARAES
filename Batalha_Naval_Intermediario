#include <stdio.h>

#define TAM_TABULEIRO 10
#define TAM_NAVIO 3
#define AGUA 0
#define NAVIO 3

int main() {

    // =========================
    // DECLARAÇÃO DO TABULEIRO
    // =========================

    int tabuleiro[TAM_TABULEIRO][TAM_TABULEIRO];

    // ===========================
    // INICIALIZAÇÃO DO TABULEIRO
    // ===========================

    for (int i = 0; i < TAM_TABULEIRO; i++) {
        for (int j = 0; j < TAM_TABULEIRO; j++) {
            tabuleiro[i][j] = AGUA;
        }
    }

    // =========================
    // DECLARAÇÃO DOS NAVIOS
    // =========================

    int navioHorizontal[TAM_NAVIO] = {NAVIO, NAVIO, NAVIO};
    int navioVertical[TAM_NAVIO]   = {NAVIO, NAVIO, NAVIO};
    int navioDiagonal1[TAM_NAVIO]  = {NAVIO, NAVIO, NAVIO};
    int navioDiagonal2[TAM_NAVIO]  = {NAVIO, NAVIO, NAVIO};

    // =========================
    // COORDENADAS INICIAIS
    // =========================

    // Navio horizontal
    int linhaH = 1;
    int colunaH = 2;

    // Navio vertical
    int linhaV = 4;
    int colunaV = 7;

    // Navio diagonal principal (\)
    int linhaD1 = 0;
    int colunaD1 = 0;

    // Navio diagonal secundária (/)
    int linhaD2 = 2;
    int colunaD2 = 8;

    // ================================
    // POSICIONAMENTO NAVIO HORIZONTAL
    // ================================

    if (colunaH + TAM_NAVIO <= TAM_TABULEIRO) {

        int podePosicionar = 1;

        for (int i = 0; i < TAM_NAVIO; i++) {
            if (tabuleiro[linhaH][colunaH + i] != AGUA) {
                podePosicionar = 0;
            }
        }

        if (podePosicionar) {
            for (int i = 0; i < TAM_NAVIO; i++) {
                tabuleiro[linhaH][colunaH + i] = navioHorizontal[i];
            }
        }
    }

    // ==============================
    // POSICIONAMENTO NAVIO VERTICAL
    // ==============================

    if (linhaV + TAM_NAVIO <= TAM_TABULEIRO) {

        int podePosicionar = 1;

        for (int i = 0; i < TAM_NAVIO; i++) {
            if (tabuleiro[linhaV + i][colunaV] != AGUA) {
                podePosicionar = 0;
            }
        }

        if (podePosicionar) {
            for (int i = 0; i < TAM_NAVIO; i++) {
                tabuleiro[linhaV + i][colunaV] = navioVertical[i];
            }
        }
    }

    // ==================================
    // POSICIONAMENTO NAVIO DIAGONAL (\)
    // ==================================

    if (linhaD1 + TAM_NAVIO <= TAM_TABULEIRO &&
        colunaD1 + TAM_NAVIO <= TAM_TABULEIRO) {

        int podePosicionar = 1;

        for (int i = 0; i < TAM_NAVIO; i++) {
            if (tabuleiro[linhaD1 + i][colunaD1 + i] != AGUA) {
                podePosicionar = 0;
            }
        }

        if (podePosicionar) {
            for (int i = 0; i < TAM_NAVIO; i++) {
                tabuleiro[linhaD1 + i][colunaD1 + i] = navioDiagonal1[i];
            }
        }
    }

    // ==================================
    // POSICIONAMENTO NAVIO DIAGONAL (/)
    // ==================================

    if (linhaD2 + TAM_NAVIO <= TAM_TABULEIRO &&
        colunaD2 - (TAM_NAVIO - 1) >= 0) {

        int podePosicionar = 1;

        for (int i = 0; i < TAM_NAVIO; i++) {
            if (tabuleiro[linhaD2 + i][colunaD2 - i] != AGUA) {
                podePosicionar = 0;
            }
        }

        if (podePosicionar) {
            for (int i = 0; i < TAM_NAVIO; i++) {
                tabuleiro[linhaD2 + i][colunaD2 - i] = navioDiagonal2[i];
            }
        }
    }

    // =======================
    // EXIBIÇÃO DO TABULEIRO
    // =======================

    printf("TABULEIRO BATALHA NAVAL - NIVEL INTERMEDIARIO\n\n");

    for (int i = 0; i < TAM_TABULEIRO; i++) {
        for (int j = 0; j < TAM_TABULEIRO; j++) {
            printf("%d ", tabuleiro[i][j]);
        }
        printf("\n");
    }

    return 0;
}
